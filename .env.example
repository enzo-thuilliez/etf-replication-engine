# Copy to .env and fill in real values. Never commit .env.
# TODO: this list will grow as the agent, MCP server, and web API are implemented.

# --- Azure OpenAI (agent, src/agent/) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- MCP server (mcp-server/) ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8787

# --- Web API (mcp-server axum API, consumed by web/) ---
API_BASE_URL=http://127.0.0.1:8787

# --- Local dev database ---
DATABASE_URL=sqlite://db/dev.sqlite

# --- Agent evaluation (eval/, scripts/llm/) ---
# EVAL_LLM_PROVIDER=
# EVAL_LLM_API_KEY=
